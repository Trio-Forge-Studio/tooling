{
	"name": "@trioforge/tooling",
	"version": "0.1.0",
	"description": "Shared checks, release commands, and Lune helpers for Trio Forge roblox-ts packages",
	"homepage": "https://github.com/Trio-Forge-Studio/tooling#readme",
	"bugs": "https://github.com/Trio-Forge-Studio/tooling/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Trio-Forge-Studio/tooling.git"
	},
	"license": "MIT",
	"bin": {
		"check-examples": "bin/check-examples.mjs",
		"stage-release": "bin/stage-release.mjs"
	},
	"files": [
		"bin",
		"lune",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
