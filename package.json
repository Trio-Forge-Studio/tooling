		"changeset": "changeset"
	},
	"devDependencies": {
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"vite-plus": "1.3.0"
	},
	"packageManager": "pnpm@12.15.0"
}
